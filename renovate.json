{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"]
  },
  "github-actions": {
    "description": "The CI workflow init writes into new projects pins the actions domainkit's CI does (test_init.py checks): one pull request updates both.",
    "managerFilePatterns": [
      "/^src/domainkit/management/templates/project/dot-github/workflows/[^/]+\\.yml-tpl$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Images CI starts with docker run, each on a line of its own as name:tag@digest. The services' images are the github-actions manager's.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "\\n\\s+(?<depName>[a-z0-9][a-z0-9._/-]*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depTypeTemplate": "docker-run"
    },
    {
      "customType": "regex",
      "description": "Tools CI installs with pipx, each version under a renovate comment.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+[A-Z_]+: \"(?<currentValue>[^\"]+)\""
      ],
      "depTypeTemplate": "ci-tool"
    }
  ],
  "packageRules": [
    {
      "description": "A library widens its supported ranges instead of moving them, so projects keep their choice. The poetry manager names PEP 621 tables by their path.",
      "matchManagers": ["poetry"],
      "matchDepTypes": ["project.dependencies", "project.optional-dependencies"],
      "rangeStrategy": "widen"
    },
    {
      "description": "Dev tools, actions and CI's images and tools: one grouped pull request for patches and digests.",
      "matchDepTypes": [
        "dependency-groups",
        "action",
        "service",
        "docker-run",
        "ci-tool"
      ],
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "groupName": "tooling patches"
    },
    {
      "description": "compose.yaml runs CI's images on laptops, and test_ci.py checks they match: their patches and digests go in the same pull request.",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "groupName": "tooling patches"
    },
    {
      "description": "Runners move by hand, with the whole of CI.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner"],
      "enabled": false
    }
  ]
}
