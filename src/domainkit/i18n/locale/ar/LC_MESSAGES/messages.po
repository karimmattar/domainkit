# domainkit's messages in Arabic.
# Compile with: domainkit compilemessages src/domainkit/i18n/locale
msgid ""
msgstr ""
"Project-Id-Version: domainkit\n"
"Language: ar\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=6; plural=n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 && n%100<=10 ? 3 : n%100>=11 ? 4 : 5;\n"

#. domainkit.http: request errors
msgid "The request is invalid."
msgstr "الطلب غير صالح."

msgid "The database is busy; try again shortly."
msgstr "قاعدة البيانات مشغولة؛ أعد المحاولة بعد قليل."

msgid ""
"A value cannot be stored: it is too long, out of range, or holds a "
"character the database refuses."
msgstr ""
"تعذّر حفظ إحدى القيم: فهي أطول من المسموح، أو خارج النطاق، أو تحتوي "
"على محرف ترفضه قاعدة البيانات."

msgid "Request body too large."
msgstr "جسم الطلب أكبر من المسموح."

msgid "Invalid host header."
msgstr "ترويسة Host غير صالحة."

msgid "Internal server error."
msgstr "حدث خطأ داخلي في الخادم."

msgid "Invalid Content-Length header."
msgstr "ترويسة Content-Length غير صالحة."

msgid "A valid metrics token is required."
msgstr "يلزم رمز وصول صالح للاطلاع على المقاييس."

msgid "Set METRICS_TOKEN to expose metrics in staging and production."
msgstr "اضبط METRICS_TOKEN لإتاحة المقاييس في بيئتي ما قبل الإنتاج والإنتاج."

msgid "The cursor is invalid; start again without one."
msgstr "المؤشر غير صالح؛ ابدأ من جديد من دونه."

msgid "Too many requests; slow down."
msgstr "طلبات كثيرة جدًا؛ تمهّل قليلًا."

msgid "Too many open connections; try again later."
msgstr "اتصالات مفتوحة كثيرة جدًا؛ أعد المحاولة لاحقًا."

msgid ""
"The data changed while this request was running; reload it and try "
"again."
msgstr "تغيّرت البيانات أثناء تنفيذ هذا الطلب؛ أعد تحميلها ثم حاول مرة أخرى."

msgid "This value is already taken."
msgstr "هذه القيمة مستخدمة بالفعل."

#. HTTP status phrases: the details of errors raised without one
msgid "Bad Request"
msgstr "طلب غير صالح"

msgid "Unauthorized"
msgstr "غير مصرّح"

msgid "Forbidden"
msgstr "محظور"

msgid "Not Found"
msgstr "غير موجود"

msgid "Method Not Allowed"
msgstr "الطريقة غير مسموح بها"

msgid "Not Acceptable"
msgstr "غير مقبول"

msgid "Conflict"
msgstr "تعارض"

msgid "Content Too Large"
msgstr "المحتوى أكبر من المسموح"

msgid "Unsupported Media Type"
msgstr "نوع الوسائط غير مدعوم"

msgid "Unprocessable Content"
msgstr "محتوى لا يمكن معالجته"

msgid "Too Many Requests"
msgstr "طلبات كثيرة جدًا"

msgid "Internal Server Error"
msgstr "خطأ داخلي في الخادم"

msgid "Service Unavailable"
msgstr "الخدمة غير متاحة"

#. domainkit.contrib.auth
msgid "Authentication credentials were not provided."
msgstr "لم تُقدَّم بيانات اعتماد للمصادقة."

msgid "You do not have permission to perform this action."
msgstr "ليست لديك صلاحية لتنفيذ هذا الإجراء."

msgid "Unable to log in with the given credentials."
msgstr "تعذّر تسجيل الدخول ببيانات الاعتماد المقدَّمة."

msgid "Your old password was entered incorrectly."
msgstr "كلمة المرور القديمة التي أدخلتها غير صحيحة."

msgid "Too many login attempts; try again later."
msgstr "محاولات تسجيل دخول كثيرة جدًا؛ حاول مرة أخرى لاحقًا."

msgid ""
"Your password or second factor changed while you logged in; log in "
"again."
msgstr "تغيّرت كلمة المرور أو التحقق بخطوتين أثناء تسجيل الدخول؛ سجّل الدخول مرة أخرى."

msgid "Tokens are not refreshed here; log in again."
msgstr "لا تُجدَّد الرموز هنا؛ سجّل الدخول مرة أخرى."

msgid "User inactive or deleted."
msgstr "المستخدم غير نشط أو محذوف."

msgid "Invalid token."
msgstr "الرمز غير صالح."

msgid "Invalid refresh token."
msgstr "رمز التجديد غير صالح."

msgid "Refresh token reused; log in again."
msgstr "أُعيد استخدام رمز التجديد؛ سجّل الدخول مرة أخرى."

msgid "Token expired."
msgstr "انتهت صلاحية الرمز."

msgid "Session ended; log in again."
msgstr "انتهت الجلسة؛ سجّل الدخول مرة أخرى."

msgid "Too many password checks at once; try again in a moment."
msgstr "عمليات تحقق كثيرة من كلمات المرور في آن واحد؛ حاول مرة أخرى بعد لحظات."

msgid "No such user."
msgstr "لا يوجد مستخدم كهذا."

msgid "No such group."
msgstr "لا توجد مجموعة كهذه."

msgid "Credentials limited to scopes cannot do this."
msgstr "لا يمكن لبيانات الاعتماد المقيَّدة بنطاقات القيام بهذا."

msgid "Credentials limited to scopes end only themselves."
msgstr "بيانات الاعتماد المقيَّدة بنطاقات لا تُنهي إلا نفسها."

msgid "Your password was entered incorrectly."
msgstr "كلمة المرور التي أدخلتها غير صحيحة."

msgid "Too many attempts; try again later."
msgstr "محاولات كثيرة جدًا؛ حاول مرة أخرى لاحقًا."

msgid "Attempts cannot be counted right now; try again later."
msgstr "لا يمكن عدّ المحاولات الآن؛ حاول مرة أخرى لاحقًا."

msgid "Too many requests for mail; try again later."
msgstr "طلبات بريد كثيرة جدًا؛ حاول مرة أخرى لاحقًا."

msgid "The link is invalid or has expired."
msgstr "الرابط غير صالح أو انتهت صلاحيته."

msgid "The code is wrong or has expired; ask for a new one."
msgstr "الرمز خاطئ أو انتهت صلاحيته؛ اطلب رمزًا جديدًا."

msgid "Give an email address, or an identifier."
msgstr "أدخل عنوان بريد إلكتروني، أو معرّفًا."

msgid "Give an email address."
msgstr "أدخل عنوان بريد إلكتروني."

msgid "The request names no origin (Origin or Referer)."
msgstr "لا يذكر الطلب مصدره (Origin أو Referer)."

msgid "The request comes from an origin that is not trusted."
msgstr "الطلب صادر عن مصدر غير موثوق."

msgid "The CSRF token is missing or wrong."
msgstr "رمز CSRF مفقود أو غير صحيح."

msgid "This request has no browser session."
msgstr "لا توجد جلسة متصفح لهذا الطلب."

msgid "A second factor is on; turn it off first."
msgstr "التحقق بخطوتين مفعَّل؛ أوقفه أولًا."

msgid "No enrolment is waiting for a code; start one first."
msgstr "لا يوجد تسجيل ينتظر رمزًا؛ ابدأ تسجيلًا أولًا."

msgid "The login has expired; log in again."
msgstr "انتهت مهلة تسجيل الدخول؛ سجّل الدخول مرة أخرى."

msgid "The code is wrong, or was used already."
msgstr "الرمز غير صحيح، أو استُخدم من قبل."

msgid ""
"Your authenticator can no longer be checked here; ask for your second "
"factor to be reset."
msgstr "لم يعد ممكنًا التحقق من تطبيق المصادقة هنا؛ اطلب إعادة ضبط التحقق بخطوتين."

msgid "No such token."
msgstr "لا يوجد رمز كهذا."

msgid "Client certificates in headers are taken from trusted proxies only."
msgstr "لا تُقبَل شهادات العميل في الترويسات إلا من الوسطاء الموثوقين."

msgid "The client certificate did not verify."
msgstr "تعذّر التحقق من شهادة العميل."

msgid "The proxy did not verify the client certificate."
msgstr "لم يتحقق الوسيط من شهادة العميل."

msgid "Malformed client certificate."
msgstr "شهادة العميل غير سليمة البنية."

msgid "Unknown client certificate."
msgstr "شهادة العميل غير معروفة."

msgid "The value is not one SecretBox encrypted."
msgstr "هذه القيمة لم تُشفَّر بواسطة SecretBox."

msgid "No key decrypts the value."
msgstr "لا يوجد مفتاح يفك تشفير هذه القيمة."

#. domainkit.contrib.idempotency
msgid "Idempotency-Key must be 1 to 255 printable ASCII characters."
msgstr ""
"يجب أن تتكوّن قيمة Idempotency-Key من ١ إلى ٢٥٥ محرفًا من محارف ASCII "
"القابلة للطباعة."

msgid "This Idempotency-Key was used for a different request."
msgstr "استُخدمت قيمة Idempotency-Key هذه لطلب مختلف."

msgid "A request with this Idempotency-Key is still in progress."
msgstr "لا يزال طلب بقيمة Idempotency-Key هذه قيد التنفيذ."

msgid ""
"The request with this Idempotency-Key already ran, and its response is no "
"longer kept; look up the result instead of retrying."
msgstr ""
"سبق تنفيذ الطلب بقيمة Idempotency-Key هذه، ولم تعد استجابته محفوظة؛ "
"استعلم عن النتيجة بدلًا من إعادة المحاولة."

#. domainkit.http.uploads and domainkit.storage
msgid "The file is too large."
msgstr "الملف أكبر من المسموح."

msgid "This type of file is not accepted."
msgstr "هذا النوع من الملفات غير مقبول."

msgid "The file is empty."
msgstr "الملف فارغ."

msgid "No file has that name."
msgstr "لا يوجد ملف بهذا الاسم."

msgid "This was changed since you read it; read it again before changing it."
msgstr "تغيّر هذا منذ قرأته؛ اقرأه مرة أخرى قبل أن تغيّره."

msgid "Send If-Match with the ETag of the version you are changing."
msgstr "أرسل الترويسة If-Match مع قيمة ETag للنسخة التي تغيّرها."

msgid "Some of these fields cannot be changed."
msgstr "بعض هذه الحقول لا يمكن تغييرها."

msgid "You do not have permission to change some of these fields."
msgstr "ليست لديك صلاحية تغيير بعض هذه الحقول."

msgid "You may not manage permissions on objects."
msgstr "لا يمكنك إدارة الصلاحيات على الكائنات."

msgid "You may grant or revoke only permissions you hold on the object."
msgstr "لا يمكنك منح أو سحب إلا الصلاحيات التي تملكها على الكائن."

msgid "You cannot grant permissions to yourself."
msgstr "لا يمكنك منح صلاحيات لنفسك."

msgid "Name a user or a group, not both or neither."
msgstr "حدّد مستخدمًا أو مجموعة، لا كليهما ولا أيًّا منهما."

msgid "That permission is not one of the object's model."
msgstr "هذه الصلاحية ليست من صلاحيات نموذج الكائن."

msgid "A grant's expiry needs a time zone."
msgstr "يحتاج موعد انتهاء المنح إلى منطقة زمنية."

msgid "A grant's expiry must be in the future."
msgstr "يجب أن يكون موعد انتهاء المنح في المستقبل."

msgid "You may not manage these webhooks."
msgstr "لا يمكنك إدارة خطافات الويب هذه."

msgid "This resource cannot answer in a media type the request accepts."
msgstr "لا يستطيع هذا المورد الرد بنوع وسائط يقبله الطلب."

msgid "This export would be too large; narrow it with filters."
msgstr "سيكون هذا التصدير كبيرًا جدًا؛ ضيّقه بالمرشحات."

msgid "Another item of the batch failed, so nothing was applied."
msgstr "فشل عنصر آخر من الدفعة، فلم يُطبَّق شيء."

msgid "You cannot create or move a record outside what you may reach."
msgstr "لا يمكنك إنشاء سجل أو نقله إلى خارج ما يحق لك الوصول إليه."

#. Pydantic's validation messages, by their templates; the error's context fills the {names}
msgid "A required value is missing."
msgstr "قيمة مطلوبة غير موجودة."

msgid "A value breaks a rule of the data: it is out of the range or set the database accepts."
msgstr "قيمة تخالف قاعدة من قواعد البيانات: إنها خارج النطاق أو المجموعة التي تقبلها قاعدة البيانات."

msgid "Name revisions, not 'base'."
msgstr "اذكر مراجعات بأسمائها، لا 'base'."

msgid "Squashing needs at least two revisions."
msgstr "الدمج يحتاج إلى مراجعتين على الأقل."

msgid "The squashed revision does not join the history."
msgstr "المراجعة المدمجة لا تتصل بسجل المراجعات."

msgctxt "validation"
msgid "Field required"
msgstr "هذا الحقل مطلوب"

msgctxt "validation"
msgid "Extra inputs are not permitted"
msgstr "لا يُسمح بمدخلات إضافية"

msgctxt "validation"
msgid "Field is frozen"
msgstr "لا يمكن تغيير هذا الحقل"

msgctxt "validation"
msgid "Input should be None"
msgstr "يجب أن تكون القيمة فارغة (null)"

msgctxt "validation"
msgid "Input should be greater than {gt}"
msgstr "يجب أن تكون القيمة أكبر من {gt}"

msgctxt "validation"
msgid "Input should be greater than or equal to {ge}"
msgstr "يجب ألا تقل القيمة عن {ge}"

msgctxt "validation"
msgid "Input should be less than {lt}"
msgstr "يجب أن تكون القيمة أصغر من {lt}"

msgctxt "validation"
msgid "Input should be less than or equal to {le}"
msgstr "يجب ألا تزيد القيمة على {le}"

msgctxt "validation"
msgid "Input should be a multiple of {multiple_of}"
msgstr "يجب أن تكون القيمة من مضاعفات {multiple_of}"

msgctxt "validation"
msgid "Input should be a finite number"
msgstr "يجب أن تكون القيمة عددًا منتهيًا"

msgctxt "validation"
msgid ""
"{field_type} should have at least {min_length} item{expected_plural} "
"after validation, not {actual_length}"
msgstr "يجب ألا يقل عدد العناصر عن {min_length}، وعددها {actual_length}"

msgctxt "validation"
msgid ""
"{field_type} should have at most {max_length} item{expected_plural} "
"after validation, not {actual_length}"
msgstr "يجب ألا يزيد عدد العناصر على {max_length}، وعددها {actual_length}"

msgctxt "validation"
msgid "Input should be iterable"
msgstr "يجب أن تكون القيمة تسلسلًا من العناصر"

msgctxt "validation"
msgid "Input should be a valid string"
msgstr "يجب أن تكون القيمة نصًا صالحًا"

msgctxt "validation"
msgid ""
"Input should be a valid string, unable to parse raw data as a unicode "
"string"
msgstr ""
"يجب أن تكون القيمة نصًا صالحًا؛ تعذّرت قراءة البيانات نصًا بترميز "
"يونيكود"

msgctxt "validation"
msgid "String should have at least {min_length} character{expected_plural}"
msgstr "يجب ألا يقل عدد الأحرف عن {min_length}"

msgctxt "validation"
msgid "String should have at most {max_length} character{expected_plural}"
msgstr "يجب ألا يزيد عدد الأحرف على {max_length}"

msgctxt "validation"
msgid "String should match pattern '{pattern}'"
msgstr "يجب أن يطابق النص النمط '{pattern}'"

msgctxt "validation"
msgid "String should contain only ASCII characters"
msgstr "يجب أن يقتصر النص على محارف ASCII"

msgctxt "validation"
msgid "Input should be {expected}"
msgstr "يجب أن تكون القيمة إحدى القيم: {expected}"

msgctxt "validation"
msgid "Input should be a valid dictionary"
msgstr "يجب أن تكون القيمة كائنًا صالحًا"

msgctxt "validation"
msgid "Input should be a valid dictionary or instance of {class_name}"
msgstr "يجب أن تكون القيمة كائنًا صالحًا"

msgctxt "validation"
msgid "Input should be a valid dictionary or object to extract fields from"
msgstr "يجب أن تكون القيمة كائنًا صالحًا"

msgctxt "validation"
msgid "Input should be a dictionary or an instance of {class_name}"
msgstr "يجب أن تكون القيمة كائنًا صالحًا"

msgctxt "validation"
msgid "Keys should be strings"
msgstr "يجب أن تكون المفاتيح نصوصًا"

msgctxt "validation"
msgid "Input should be a valid list"
msgstr "يجب أن تكون القيمة قائمة صالحة"

msgctxt "validation"
msgid "Input should be a valid tuple"
msgstr "يجب أن تكون القيمة قائمة صالحة"

msgctxt "validation"
msgid "Input should be a valid set"
msgstr "يجب أن تكون القيمة مجموعة صالحة"

msgctxt "validation"
msgid "Input should be a valid frozenset"
msgstr "يجب أن تكون القيمة مجموعة صالحة"

msgctxt "validation"
msgid "Input should be a valid boolean"
msgstr "يجب أن تكون القيمة منطقية (true أو false)"

msgctxt "validation"
msgid "Input should be a valid boolean, unable to interpret input"
msgstr "يجب أن تكون القيمة منطقية (true أو false)؛ تعذّر تفسيرها"

msgctxt "validation"
msgid "Input should be a valid integer"
msgstr "يجب أن تكون القيمة عددًا صحيحًا"

msgctxt "validation"
msgid "Input should be a valid integer, unable to parse string as an integer"
msgstr "يجب أن تكون القيمة عددًا صحيحًا؛ تعذّرت قراءة النص عددًا صحيحًا"

msgctxt "validation"
msgid "Unable to parse input string as an integer, exceeded maximum size"
msgstr "تعذّرت قراءة النص عددًا صحيحًا لأنه يتجاوز الحجم الأقصى"

msgctxt "validation"
msgid "Input should be a valid integer, got a number with a fractional part"
msgstr "يجب أن تكون القيمة عددًا صحيحًا، لا عددًا بكسر عشري"

msgctxt "validation"
msgid "Input should be a valid number"
msgstr "يجب أن تكون القيمة عددًا صالحًا"

msgctxt "validation"
msgid "Input should be a valid number, unable to parse string as a number"
msgstr "يجب أن تكون القيمة عددًا صالحًا؛ تعذّرت قراءة النص عددًا"

msgctxt "validation"
msgid "Input should be a valid bytes"
msgstr "يجب أن تكون القيمة بيانات ثنائية صالحة"

msgctxt "validation"
msgid "Data should have at least {min_length} byte{expected_plural}"
msgstr "يجب ألا يقل حجم البيانات عن {min_length} بايت"

msgctxt "validation"
msgid "Data should have at most {max_length} byte{expected_plural}"
msgstr "يجب ألا يزيد حجم البيانات على {max_length} بايت"

msgctxt "validation"
msgid "Value error, {error}"
msgstr "قيمة غير صالحة: {error}"

msgctxt "validation"
msgid "Assertion failed, {error}"
msgstr "لم يتحقق الشرط: {error}"

msgctxt "validation"
msgid "Input should be a valid date"
msgstr "يجب أن تكون القيمة تاريخًا صالحًا"

msgctxt "validation"
msgid "Input should be a valid date in the format YYYY-MM-DD, {error}"
msgstr "يجب أن تكون القيمة تاريخًا صالحًا بالصيغة YYYY-MM-DD"

msgctxt "validation"
msgid "Input should be a valid date or datetime, {error}"
msgstr "يجب أن تكون القيمة تاريخًا، أو تاريخًا ووقتًا، صالحًا"

msgctxt "validation"
msgid ""
"Datetimes provided to dates should have zero time - e.g. be exact "
"dates"
msgstr "يجب أن يكون الوقت صفرًا حين يُقدَّم تاريخ ووقت في مكان تاريخ"

msgctxt "validation"
msgid "Date should be in the past"
msgstr "يجب أن يكون التاريخ في الماضي"

msgctxt "validation"
msgid "Date should be in the future"
msgstr "يجب أن يكون التاريخ في المستقبل"

msgctxt "validation"
msgid "Input should be a valid time"
msgstr "يجب أن تكون القيمة وقتًا صالحًا"

msgctxt "validation"
msgid "Input should be in a valid time format, {error}"
msgstr "يجب أن تكون القيمة وقتًا بصيغة صالحة"

msgctxt "validation"
msgid "Input should be a valid datetime"
msgstr "يجب أن تكون القيمة تاريخًا ووقتًا صالحين"

msgctxt "validation"
msgid "Input should be a valid datetime, {error}"
msgstr "يجب أن تكون القيمة تاريخًا ووقتًا صالحين"

msgctxt "validation"
msgid "Input should be a valid datetime or date, {error}"
msgstr "يجب أن تكون القيمة تاريخًا ووقتًا، أو تاريخًا، صالحًا"

msgctxt "validation"
msgid "Input should be in the past"
msgstr "يجب أن تكون القيمة في الماضي"

msgctxt "validation"
msgid "Input should be in the future"
msgstr "يجب أن تكون القيمة في المستقبل"

msgctxt "validation"
msgid "Input should not have timezone info"
msgstr "يجب ألا تتضمن القيمة منطقة زمنية"

msgctxt "validation"
msgid "Input should have timezone info"
msgstr "يجب أن تتضمن القيمة منطقة زمنية"

msgctxt "validation"
msgid "Timezone offset of {tz_expected} required, got {tz_actual}"
msgstr "يلزم فرق توقيت قدره {tz_expected} ثانية، والمقدَّم {tz_actual}"

msgctxt "validation"
msgid "Input should be a valid timedelta"
msgstr "يجب أن تكون القيمة مدة زمنية صالحة"

msgctxt "validation"
msgid "Input should be a valid timedelta, {error}"
msgstr "يجب أن تكون القيمة مدة زمنية صالحة"

msgctxt "validation"
msgid "Input should be a valid UUID, {error}"
msgstr "يجب أن تكون القيمة معرّف UUID صالحًا"

msgctxt "validation"
msgid "UUID input should be a string, bytes or UUID object"
msgstr "يجب أن يكون معرّف UUID نصًا"

msgctxt "validation"
msgid "UUID version {expected_version} expected"
msgstr "يجب أن يكون معرّف UUID من الإصدار {expected_version}"

msgctxt "validation"
msgid "Input should be a valid decimal"
msgstr "يجب أن تكون القيمة عددًا عشريًا صالحًا"

msgctxt "validation"
msgid "Decimal input should be an integer, float, string or Decimal object"
msgstr "يجب أن تكون القيمة العشرية عددًا أو نصًا"

msgctxt "validation"
msgid ""
"Decimal input should have no more than {max_digits} "
"digit{expected_plural} in total"
msgstr "يجب ألا يزيد عدد خانات القيمة على {max_digits}"

msgctxt "validation"
msgid ""
"Decimal input should have no more than {decimal_places} decimal "
"place{expected_plural}"
msgstr "يجب ألا يزيد عدد الخانات بعد الفاصلة العشرية على {decimal_places}"

msgctxt "validation"
msgid ""
"Decimal input should have no more than {whole_digits} "
"digit{expected_plural} before the decimal point"
msgstr "يجب ألا يزيد عدد الخانات قبل الفاصلة العشرية على {whole_digits}"

msgctxt "validation"
msgid "Input should be a valid URL, {error}"
msgstr "يجب أن تكون القيمة عنوان URL صالحًا"

msgctxt "validation"
msgid "URL input should be a string or URL"
msgstr "يجب أن يكون عنوان URL نصًا"

msgctxt "validation"
msgid "Input violated strict URL syntax rules, {error}"
msgstr "تخالف القيمة قواعد صياغة عناوين URL"

msgctxt "validation"
msgid "URL should have at most {max_length} character{expected_plural}"
msgstr "يجب ألا يزيد عدد أحرف عنوان URL على {max_length}"

msgctxt "validation"
msgid "URL scheme should be {expected_schemes}"
msgstr "يجب أن يكون مخطط عنوان URL أحد المخططات: {expected_schemes}"

msgctxt "validation"
msgid "Invalid JSON: {error}"
msgstr "صيغة JSON غير صالحة"

msgctxt "validation"
msgid "JSON input should be string, bytes or bytearray"
msgstr "يجب أن تكون مدخلات JSON نصًا أو بيانات ثنائية"

msgctxt "validation"
msgid ""
"Input tag '{tag}' found using {discriminator} does not match any of "
"the expected tags: {expected_tags}"
msgstr "الوسم '{tag}' لا يطابق أيًا من الوسوم المتوقعة: {expected_tags}"

msgctxt "validation"
msgid "Unable to extract tag using discriminator {discriminator}"
msgstr "تعذّر استخراج الوسم باستخدام {discriminator}"

#. domainkit.contrib.auth: identity checks
msgid "Enter one email address, such as user@example.com, without a name."
msgstr "أدخل عنوان بريد إلكتروني واحدًا، مثل user@example.com، بلا اسم."

msgid ""
"An account already uses this username or this address; sign up again "
"with another username, or log in."
msgstr "يستخدم حسابٌ هذا الاسم أو هذا العنوان بالفعل؛ سجِّل من جديد باسم مستخدم آخر، أو سجِّل الدخول."

msgid "Usernames that start with erased- are kept for erased accounts."
msgstr "أسماء المستخدمين التي تبدأ بـ erased- محجوزة للحسابات الممحوّة."

#. domainkit.http: deadlines and load shedding
msgid "The request took too long; try again shortly."
msgstr "استغرق الطلب وقتًا أطول من اللازم؛ أعد المحاولة بعد قليل."

msgid "The server is busy; try again shortly."
msgstr "الخادم مشغول؛ أعد المحاولة بعد قليل."

#. domainkit.http: request bodies
msgid "The request body took too long to arrive."
msgstr "استغرق وصول جسم الطلب وقتًا أطول من اللازم."

#. domainkit.contrib.idempotency
msgid "An Idempotency-Key needs a caller this service knows: authenticate, or send the request without the key."
msgstr "يحتاج مفتاح Idempotency-Key إلى متّصل تعرفه هذه الخدمة: سجّل الدخول، أو أرسل الطلب دون المفتاح."

#. domainkit.contrib.auth: startup checks
msgid "AUTH settings cannot be used"
msgstr "لا يمكن استخدام إعدادات AUTH"

#. domainkit.contrib.accounting
msgid "No account has that id."
msgstr "لا يوجد حساب بهذا المعرّف."

msgid "No journal entry has that id."
msgstr "لا يوجد قيد يومية بهذا المعرّف."

msgid "No hold has that id."
msgstr "لا يوجد حجز بهذا المعرّف."

msgid "No accounting period has that id."
msgstr "لا توجد فترة محاسبية بهذا المعرّف."

msgid "The ledger keeps at most four decimal places."
msgstr "يحفظ الدفتر أربع خانات عشرية على الأكثر."

msgid "An amount is more than zero."
msgstr "يجب أن يكون المبلغ أكبر من الصفر."

msgid "An amount is not in its account's currency."
msgstr "المبلغ ليس بعملة حسابه."

msgid "An account's code has up to 32 letters, digits, '.', '_', or '-'."
msgstr "رمز الحساب يصل إلى ٣٢ حرفًا أو رقمًا أو '.' أو '_' أو '-'."

msgid "An account's name has 1 to 200 characters."
msgstr "اسم الحساب من ١ إلى ٢٠٠ حرف."

msgid "An account's holder has 1 to 255 characters."
msgstr "صاحب الحساب من ١ إلى ٢٥٥ حرفًا."

msgid "The account is closed."
msgstr "الحساب مغلق."

msgid "The account does not have enough available."
msgstr "ليس في الحساب ما يكفي من الرصيد المتاح."

msgid "Only an account with nothing on it can be closed."
msgstr "لا يُغلق إلا حساب لا رصيد عليه ولا حجز."

msgid "A source has up to 64 lower-case letters, digits, '_', '.', ':', or '-'."
msgstr "المصدر يصل إلى ٦٤ حرفًا صغيرًا أو رقمًا أو '_' أو '.' أو ':' أو '-'."

msgid "A reference has 1 to 128 printable characters."
msgstr "المرجع من ١ إلى ١٢٨ حرفًا قابلًا للطباعة."

msgid "A description has at most 255 characters."
msgstr "الوصف ٢٥٥ حرفًا على الأكثر."

msgid "A memo has at most 255 characters."
msgstr "الملاحظة ٢٥٥ حرفًا على الأكثر."

msgid "An entry has at least two lines, and at most ACCOUNTING.MAX_LINES."
msgstr "للقيد سطران على الأقل، وACCOUNTING.MAX_LINES على الأكثر."

msgid "The entry's debits and credits differ in a currency."
msgstr "يختلف مدين القيد عن دائنه في إحدى العملات."

msgid "Another entry was posted under this source and reference."
msgstr "رُحِّل قيد آخر بهذا المصدر وهذا المرجع."

msgid "Another hold was placed under this source and reference."
msgstr "وُضع حجز آخر بهذا المصدر وهذا المرجع."

msgid "No open accounting period covers the entry's date."
msgstr "لا توجد فترة محاسبية مفتوحة تشمل تاريخ القيد."

msgid "The entry's date is in a closed period."
msgstr "تاريخ القيد في فترة مغلقة."

msgid "Another period covers some of these dates."
msgstr "تشمل فترة أخرى بعض هذه التواريخ."

msgid "A period's name has 1 to 64 characters."
msgstr "اسم الفترة من ١ إلى ٦٤ حرفًا."

msgid "A period ends on or after the day it starts."
msgstr "تنتهي الفترة في يوم بدايتها أو بعده."

msgid "A hold expires in the future, within 366 days."
msgstr "ينتهي الحجز في المستقبل، خلال ٣٦٦ يومًا."

msgid "The hold was captured, released, or has expired."
msgstr "الحجز حُصِّل أو أُفرج عنه أو انتهى."

msgid "The hold was captured."
msgstr "الحجز حُصِّل."

msgid "A capture takes more than zero, up to the hold."
msgstr "يأخذ التحصيل أكثر من الصفر، وحتى مبلغ الحجز."

msgid "A statement is sent as text/csv."
msgstr "يُرسل الكشف بصيغة text/csv."

msgid "A statement is UTF-8 text."
msgstr "الكشف نص بترميز UTF-8."

msgid "A statement needs the columns id, date, amount, and currency."
msgstr "يحتاج الكشف إلى الأعمدة id وdate وamount وcurrency."

msgid "A statement line's id has 1 to 128 characters."
msgstr "معرّف سطر الكشف من ١ إلى ١٢٨ حرفًا."

msgid "A statement line's amount is not an amount."
msgstr "مبلغ سطر الكشف ليس مبلغًا."

msgid "A statement line's date is not a date."
msgstr "تاريخ سطر الكشف ليس تاريخًا."

msgid "A statement line's amount does not fit its currency."
msgstr "مبلغ سطر الكشف لا يناسب عملته."

msgid "A statement line is not in the account's currency."
msgstr "سطر الكشف ليس بعملة الحساب."

msgid "Two statement lines have the same id."
msgstr "لسطرين من الكشف المعرّف نفسه."

msgid "A statement has at most ACCOUNTING.MAX_STATEMENT_LINES lines."
msgstr "للكشف ACCOUNTING.MAX_STATEMENT_LINES سطرًا على الأكثر."

msgid "The sources that start with 'accounting.' are the ledger's own."
msgstr "المصادر التي تبدأ بـ 'accounting.' خاصة بدفتر الحسابات نفسه."

msgid "A hold's expiry needs a time zone."
msgstr "يحتاج موعد انتهاء الحجز إلى منطقة زمنية."

msgid "A statement cannot be read as CSV."
msgstr "لا يمكن قراءة الكشف بصيغة CSV."

msgid ""
"A statement line's reference has up to 128 characters, and "
"its description up to 255."
msgstr "مرجع سطر الكشف حتى ١٢٨ حرفًا، ووصفه حتى ٢٥٥ حرفًا."

msgid ""
"A statement line's reference and description have no control "
"characters."
msgstr "لا يحوي مرجع سطر الكشف ولا وصفه محارف تحكم."

msgid "A statement line differs from the line imported before under its id."
msgstr "يختلف سطر الكشف عن السطر المستورد من قبل بمعرّفه نفسه."

#. domainkit.money: amounts and currencies
msgid "The amount of money is not valid."
msgstr "مبلغ المال غير صالح."

msgid "The currency is not one this service knows."
msgstr "هذه العملة ليست من العملات التي تعرفها هذه الخدمة."

msgid "The amount has more decimal places than its currency has."
msgstr "في المبلغ منازل عشرية أكثر مما لعملته."

msgid "The amounts are in different currencies."
msgstr "المبالغ بعملات مختلفة."

msgid ""
"Give money as an object of an amount and a currency, and nothing "
"else."
msgstr "أرسل المال كائنًا فيه مبلغ وعملة، ولا شيء غيرهما."

msgid ""
"Give the amount as text, such as 10.50, with at most 38 digits "
"before the point."
msgstr ""
"أرسل المبلغ نصًا، مثل 10.50، وفيه 38 رقمًا على الأكثر قبل الفاصلة "
"العشرية."

msgid "The amount has more digits than this field holds."
msgstr "في المبلغ أرقام أكثر مما يتسع له هذا الحقل."

msgid "This command needs approval: submit it for approval."
msgstr "يحتاج هذا الأمر إلى موافقة: قدّمه طلبًا للموافقة."

msgid "This command needs approval: it was submitted for approval."
msgstr "يحتاج هذا الأمر إلى موافقة: قُدّم طلبًا للموافقة."

msgid "No approval request has that id."
msgstr "لا يوجد طلب موافقة بهذا المعرّف."

msgid "No guarded command has that name."
msgstr "لا يوجد أمر محميّ بهذا الاسم."

msgid "The arguments do not make the command."
msgstr "المعطيات لا تكوّن الأمر."

msgid "The command is larger than APPROVALS allows."
msgstr "الأمر أكبر مما يسمح به APPROVALS."

msgid "The command is not the one this action takes."
msgstr "هذا الأمر ليس الأمر الذي يأخذه هذا الإجراء."

msgid "The command reads otherwise now than when it was approved."
msgstr "يُقرأ الأمر الآن على غير ما كان عليه حين الموافقة عليه."

msgid "This command needs no approval: run it directly."
msgstr "لا يحتاج هذا الأمر إلى موافقة: نفّذه مباشرة."

msgid "A maker's id has 1 to 255 characters."
msgstr "معرّف مقدّم الطلب من حرف واحد إلى ٢٥٥ حرفًا."

msgid "An approver's id has 1 to 255 characters."
msgstr "معرّف الموافِق من حرف واحد إلى ٢٥٥ حرفًا."

msgid "A reason has at most 500 characters."
msgstr "السبب ٥٠٠ حرف على الأكثر."

msgid "The request is no longer waiting for a decision."
msgstr "لم يعد الطلب في انتظار قرار."

msgid "The request has expired."
msgstr "انتهت مدة الطلب."

msgid "Whoever submitted a request cannot decide it."
msgstr "لا يحق لمن قدّم الطلب أن يبتّ فيه."

msgid "You have decided this request already."
msgstr "سبق أن بتَتّ في هذا الطلب."

msgid "The request holds another command than the one decided on."
msgstr "يحمل الطلب أمرًا غير الذي بُتّ فيه."

msgid "Only whoever submitted a request can cancel it."
msgstr "لا يلغي الطلب إلا من قدّمه."

msgid "The request holds another command than the one approved."
msgstr "يحمل الطلب أمرًا غير الذي وُوفق عليه."

msgid "The request is not waiting to run."
msgstr "الطلب ليس في انتظار التنفيذ."

msgid "You may not submit this command."
msgstr "لا يحق لك تقديم هذا الأمر."

msgid "You are not one of the approvers of this request."
msgstr "لست من الموافقين على هذا الطلب."

msgid "You cannot approve this request now."
msgstr "لا يمكنك الموافقة على هذا الطلب الآن."

#. domainkit.contrib.auth: step-ups, transactions' authorizations, first use
msgid "Confirm it is you: authenticate again to do this."
msgstr "تحقّق من هويتك: أعِد المصادقة لتقوم بهذا."

msgid "Turn on a second factor first: confirming it is you needs one."
msgstr "فعّل عامل تحقق ثانيًا أولًا: التحقق من هويتك يحتاج إليه."

msgid "These credentials cannot step up: log in, then step up."
msgstr "لا يمكن تعزيز التحقق ببيانات الاعتماد هذه: سجّل الدخول، ثم عزّز التحقق."

msgid "Enter your password as well."
msgstr "أدخل كلمة المرور أيضًا."

msgid "This transaction is not authorized: confirm its amount and payee, then try again."
msgstr "هذه المعاملة غير مُصرَّح بها: أكّد مبلغها والمستفيد منها، ثم أعد المحاولة."

msgid "This transaction was confirmed already."
msgstr "أُكِّدت هذه المعاملة من قبل."

msgid "This transaction can no longer be confirmed; start it again."
msgstr "لم يعد ممكنًا تأكيد هذه المعاملة؛ ابدأها من جديد."

msgid "No such transaction."
msgstr "لا توجد معاملة كهذه."

msgid "This password was set for you: choose a new one to log in."
msgstr "عُيّنت كلمة المرور هذه لك: اختر كلمة مرور جديدة لتسجيل الدخول."

msgid "A transaction's amount must be more than zero."
msgstr "يجب أن يكون مبلغ المعاملة أكبر من صفر."

msgid "A purpose is a lower-case name, such as transfer or payments.payout."
msgstr "الغرض اسم بأحرف صغيرة، مثل transfer أو payments.payout."

#. domainkit.money: where amounts are kept
msgid "The amount is larger, or has more decimal places, than can be stored."
msgstr "المبلغ أكبر مما يمكن حفظه، أو فيه منازل عشرية أكثر مما يمكن حفظه."

#. domainkit.contrib.limits
msgid "No limit has that id."
msgstr "لا يوجد حدّ بهذا المعرّف."

msgid "Limits keep amounts of at most four decimal places."
msgstr "تحفظ الحدود مبالغ بأربع خانات عشرية على الأكثر."

msgid "A kind of subject has up to 32 lower-case letters, digits, or '_', starting with a letter."
msgstr "نوع الطرف حتى 32 حرفًا لاتينيًا صغيرًا أو رقمًا أو '_'، يبدأ بحرف."

msgid "A subject has 1 to 255 printable characters."
msgstr "للطرف من 1 إلى 255 محرفًا قابلًا للطباعة."

msgid "The time zone is not one, such as 'Africa/Cairo'."
msgstr "هذه ليست منطقة زمنية، مثل 'Africa/Cairo'."

msgid "A limit's code has up to 64 lower-case letters, digits, '_', '.', ':', or '-'."
msgstr "رمز الحدّ حتى 64 حرفًا لاتينيًا صغيرًا أو رقمًا أو '_' أو '.' أو ':' أو '-'."

msgid "A limit's count is at least one."
msgstr "عدد الحدّ واحد على الأقل."

msgid "A window needs a maximum amount or count, and they need a window."
msgstr "تحتاج الفترة إلى حدّ أقصى للمبلغ أو للعدد، ويحتاج كلاهما إلى فترة."

msgid "A limit sets an amount per transaction, or a maximum over a window."
msgstr "يحدّد الحدّ مبلغًا لكل معاملة، أو حدًا أقصى خلال فترة."

msgid "A limit's note has at most 255 characters."
msgstr "لملاحظة الحدّ 255 محرفًا على الأكثر."

msgid "A limit's amounts are in its currency."
msgstr "مبالغ الحدّ بعملته."

msgid "A limit's amounts are more than zero."
msgstr "مبالغ الحدّ أكبر من صفر."

msgid "A movement's amount is more than zero."
msgstr "مبلغ الحركة أكبر من صفر."

msgid "A movement names at least one subject."
msgstr "تسمّي الحركة طرفًا واحدًا على الأقل."

msgid "The amount is more than one movement may be."
msgstr "المبلغ أكبر مما يُسمح به لحركة واحدة."

msgid "The amount is more than a limit allows in its period."
msgstr "المبلغ أكبر مما يسمح به حدّ خلال فترته."

msgid "There have been as many of these as a limit allows in its period."
msgstr "بلغ عدد هذه الحركات ما يسمح به حدّ خلال فترته."

#. domainkit.contrib.accounting: reversals
msgid "A reversal is not reversed: post the entry again instead."
msgstr "لا يُعكس قيدُ العكس: سجّل القيد من جديد بدلًا من ذلك."

msgid "Whoever the command is about cannot decide it."
msgstr "لا يحق لمن يخصّه الأمر أن يبتّ فيه."

msgid "Only a superuser may make a superuser."
msgstr "لا يجعل مستخدمًا مستخدمًا خارقًا إلا مستخدم خارق."

msgid "The request was changed outside the application; it is neither decided nor run."
msgstr "عُدّل الطلب خارج التطبيق؛ فلا يُبتّ فيه ولا يُنفّذ."

msgid "The request's guard or policy no longer exists; it is neither decided nor run."
msgstr "لم تعد حماية الطلب أو سياسته موجودة؛ فلا يُبتّ فيه ولا يُنفّذ."

msgid "The amount is larger than the ledger keeps."
msgstr "المبلغ أكبر مما يحفظه الدفتر."

msgid "The amount is larger than limits keep."
msgstr "المبلغ أكبر مما تحفظه الحدود."

msgid "The books are closed up to a later date than this one."
msgstr "الدفاتر مقفلة حتى تاريخ لاحق لهذا التاريخ."

msgid "A period before this one is still open: close it first."
msgstr "ما زالت فترة سابقة لهذه مفتوحة: أقفلها أولًا."

msgid "No limit names this currency for this subject: it moves none."
msgstr "لا يسمّي أي حدّ هذه العملة لهذه الجهة: فلا تُحرّك منها شيئًا."

msgid "Whoever submitted this command may no longer make it."
msgstr "لم يعد يحق لمن قدّم هذا الأمر أن يجريه."

msgid "This person's data must be kept for now: nothing was erased."
msgstr "يجب حفظ بيانات هذا الشخص الآن: لم يُمحَ شيء منها."

#. domainkit.resources and domainkit.http.client: races and outgoing calls
msgid ""
"This record changed while it was being checked; read it again and "
"retry."
msgstr "تغيّر هذا السجل أثناء التحقق منه؛ اقرأه مرة أخرى ثم أعد المحاولة."

msgid "A service this one depends on failed; try again later."
msgstr "تعطّلت خدمة تعتمد عليها هذه الخدمة؛ أعد المحاولة لاحقًا."

msgid "A service this one depends on is unavailable; try again later."
msgstr "خدمة تعتمد عليها هذه الخدمة غير متاحة؛ أعد المحاولة لاحقًا."

msgid "A service this one depends on took too long to answer."
msgstr "استغرقت خدمة تعتمد عليها هذه الخدمة وقتًا طويلًا للرد."

msgid "A service this one depends on answered with more than can be read."
msgstr "ردّت خدمة تعتمد عليها هذه الخدمة بأكثر مما يمكن قراءته."

#. domainkit.contrib.auth and domainkit.http.uploads: impersonation, captcha, scanning
msgid "Impersonation is off (AUTH.IMPERSONATION_TTL)."
msgstr "انتحال الهوية معطّل (AUTH.IMPERSONATION_TTL)."

msgid "Only active users can be impersonated."
msgstr "لا يمكن انتحال هوية إلا المستخدمين النشطين."

msgid "Staff cannot impersonate themselves."
msgstr "لا يمكن للموظفين انتحال هوياتهم."

msgid "The captcha was missing or not solved."
msgstr "اختبار التحقق مفقود أو لم يُحَل."

msgid "The virus scan refused the file."
msgstr "رفض فحص الفيروسات الملف."

#. domainkit.inspection: an upload's check refused it
msgid "Files with scripts are not accepted."
msgstr "لا تُقبل الملفات التي تحتوي على نصوص برمجية."

msgid "Files with macros are not accepted."
msgstr "لا تُقبل الملفات التي تحتوي على وحدات ماكرو."

msgid "Files with actions that run by themselves, open other files, or send data are not accepted."
msgstr "لا تُقبل الملفات التي تحتوي على إجراءات تعمل من تلقاء نفسها أو تفتح ملفات أخرى أو ترسل بيانات."

msgid "Files with embedded files or objects are not accepted."
msgstr "لا تُقبل الملفات التي تضمّ ملفات أو كائنات مضمّنة."

msgid "Files that load content from elsewhere are not accepted."
msgstr "لا تُقبل الملفات التي تحمّل محتوى من مكان آخر."

msgid "PDF files with XFA forms are not accepted."
msgstr "لا تُقبل ملفات PDF التي تحتوي على نماذج XFA."

msgid "Files with a document type declaration are not accepted."
msgstr "لا تُقبل الملفات التي تحتوي على تعريف لنوع المستند (DTD)."

msgid "Files protected by a password are not accepted."
msgstr "لا تُقبل الملفات المحمية بكلمة مرور."

msgid "The file has too many pages."
msgstr "عدد صفحات الملف كبير جدًا."

msgid "The file is too large or too complex to check."
msgstr "الملف أكبر أو أعقد من أن يُفحص."

msgid "The file could not be read."
msgstr "تعذّرت قراءة الملف."

msgid "The file took too long to check."
msgstr "استغرق فحص الملف وقتًا أطول مما يُسمح به."

msgid "The file needed too much memory to check."
msgstr "احتاج فحص الملف إلى ذاكرة أكثر مما يُسمح به."

msgid "Uploads cannot be checked now; try again later."
msgstr "لا يمكن فحص الملفات المرفوعة الآن؛ حاول مرة أخرى لاحقًا."

msgid "An impersonation cannot impersonate."
msgstr "لا يمكن لمنتحل الهوية أن ينتحل هوية أخرى."

msgid "Confirm it is you: send your password, or step up first."
msgstr "أكّد أنك أنت: أرسل كلمة المرور، أو عزّز التحقق أولًا."

msgid "Approve this sign-in from your mobile app."
msgstr "وافق على تسجيل الدخول هذا من تطبيقك على الهاتف."

msgid "Manage your logins from your mobile app."
msgstr "أدِر تسجيلات دخولك من تطبيقك على الهاتف."

msgid "This server decides what this change does to your devices' logins: leave keep_device_logins out."
msgstr "يحدد الخادم ما يفعله هذا التغيير بتسجيلات دخول أجهزتك: لا ترسل keep_device_logins."

msgid "Enroll your mobile app first: you log in from it."
msgstr "سجّل تطبيقك على الهاتف أولًا: منه تسجّل الدخول."

msgid "Your mobile app cannot be asked now: bind it, or answer what waits."
msgstr "لا يمكن سؤال تطبيقك على الهاتف الآن: اربطه، أو أجب عمّا ينتظر."

msgid "This transaction was confirmed already, or expired; start it again."
msgstr "تم تأكيد هذه المعاملة من قبل، أو انتهت صلاحيتها؛ ابدأها من جديد."

msgid "This transaction needs your password too: confirm it on this page."
msgstr "تحتاج هذه المعاملة إلى كلمة المرور أيضًا: أكّدها في هذه الصفحة."

msgid "No sign-in request of yours waits with that id."
msgstr "لا يوجد طلب تسجيل دخول لك بهذا المعرّف ينتظر الرد."

msgid "That code expired or was used; scan the new one on the page."
msgstr "انتهت صلاحية هذا الرمز أو استُخدم؛ امسح الرمز الجديد على الصفحة."

msgid "Scan the code from a phone on the same network as the page."
msgstr "امسح الرمز من هاتف على الشبكة نفسها التي تُعرض عليها الصفحة."

msgid "That is not the number on the sign-in page; the sign-in is denied."
msgstr "هذا ليس الرقم الظاهر على صفحة تسجيل الدخول؛ رُفض تسجيل الدخول."

msgid "The sign-in waits for the phone; ask again later."
msgstr "تسجيل الدخول بانتظار الهاتف؛ اسأل مرة أخرى لاحقًا."

msgid "Asked too often; wait longer between polls."
msgstr "طلبات متكررة جدًا؛ انتظر مدة أطول بين الاستعلامات."

msgid "The sign-in expired; start a new one."
msgstr "انتهت صلاحية تسجيل الدخول؛ ابدأ تسجيلًا جديدًا."

msgid "The sign-in was denied."
msgstr "رُفض تسجيل الدخول."

msgid "No sign-in waits with that handle."
msgstr "لا يوجد تسجيل دخول ينتظر بهذا المعرّف."

msgid "Too many sign-ins were started; try again later."
msgstr "بُدئت محاولات تسجيل دخول كثيرة جدًا؛ حاول مرة أخرى لاحقًا."

msgid "Too many requests were sent to your phone; try again later."
msgstr "أُرسلت طلبات كثيرة جدًا إلى هاتفك؛ حاول مرة أخرى لاحقًا."

#. domainkit.contrib.auth and domainkit.contrib.ciba: action authorizations
msgid "A rule accepted an authorization that no service spent: decorate the act's service with requires_authorization."
msgstr "قبلت قاعدةٌ تفويضًا لم تستهلكه أي خدمة: زيّن خدمة الإجراء بـ requires_authorization."

msgid "Authorize this act first: ask for an authorization of it, confirm it, and send it in the Action-Authorization header."
msgstr "صرِّح بهذا الإجراء أولًا: اطلب تفويضًا له، وأكّده، وأرسله في ترويسة Action-Authorization."

msgid "No such authorization."
msgstr "لا يوجد تفويض كهذا."

msgid "Send the digest of the act you were shown to approve it."
msgstr "أرسل بصمة الإجراء الذي عُرض عليك لتوافق عليه."

msgid "These credentials cannot ask for an authorization: log in, then ask."
msgstr "لا يمكن طلب تفويض ببيانات الاعتماد هذه: سجّل الدخول، ثم اطلب."

msgid "This act is not authorized: ask for an authorization of it, confirm it, then try again."
msgstr "هذا الإجراء غير مُصرَّح به: اطلب تفويضًا له، وأكّده، ثم أعد المحاولة."

msgid "This act is not the one you were shown."
msgstr "هذا الإجراء ليس الذي عُرض عليك."

msgid "This act must be confirmed another way."
msgstr "يجب تأكيد هذا الإجراء بطريقة أخرى."

msgid "This authorization can no longer be confirmed; ask for a new one."
msgstr "لم يعد ممكنًا تأكيد هذا التفويض؛ اطلب تفويضًا جديدًا."

msgid "This authorization was confirmed already, or ended."
msgstr "أُكِّد هذا التفويض من قبل، أو انتهى."

#. domainkit.contrib.auth: breached passwords
msgid "This password has appeared in a data breach: choose another one."
msgstr "ظهرت كلمة المرور هذه في تسريب للبيانات: اختر كلمة مرور أخرى."

msgid "Your password can't be one that has appeared in a data breach."
msgstr "لا يمكن أن تكون كلمة مرورك قد ظهرت في تسريب للبيانات."

msgid "Passwords cannot be checked against data breaches now; try again later."
msgstr "يتعذّر الآن التحقق من كلمات المرور في تسريبات البيانات؛ أعد المحاولة لاحقًا."

