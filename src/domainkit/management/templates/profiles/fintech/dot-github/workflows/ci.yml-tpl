# The project's checks on every push and pull request: the code as ruff
# formats it, its types (mypy --strict), the layer rules and settings
# (check), every model change in a migration, the tests, and the image
# built. Actions are pinned to commit SHAs, as domainkit's own CI pins
# them; Renovate or Dependabot keep them new.
name: ci

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  test:
    name: Lint, check, and test
    runs-on: ubuntu-latest
    env:
      # .env is not committed: the commands run with the local settings,
      # on a SQLite file; pytest uses config.settings.test.
      {{ prefix }}SETTINGS_MODULE: config.settings.local
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.13"
      - name: Install
        # The dependencies pyproject.toml names, and its dev group.
        run: |
          python -m pip install --upgrade pip
          python -c "import tomllib; print('\n'.join(tomllib.load(open('pyproject.toml', 'rb'))['project']['dependencies']))" > requirements.txt
          python -m pip install --group dev -r requirements.txt
      - name: Lint
        run: |
          ruff check .
          ruff format --check .
          mypy
      - name: Check
        run: python manage.py check
      - name: Migrations
        run: |
          python manage.py migrate
          python manage.py makemigrations --check -m "unused"
      - name: Test
        run: pytest

  image:
    name: Build the image
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Build
        run: docker build -t {{ project }} .
