"""Use cases: open a unit of work, change one aggregate, commit."""

from typing import Final

from domainkit.apps import registry
from domainkit.contrib.approvals import ApprovalsSettings, Threshold, requires_approval
from domainkit.contrib.evidence import Evidence
from domainkit.contrib.evidence.tasks import defer_evidence
from domainkit.money import Money

from domains.payments.application.commands import MakeTransfer, RegisterCard
from domains.payments.application.unit_of_work import PaymentsUnitOfWork
from domains.payments.domain.model import (
    Card,
    CardId,
    CardNotFound,
    Transfer,
    TransferId,
    TransferTooLarge,
)

MAKE_TRANSFER: Final = "payments.make_transfer"
"""The guarded action: a transfer over the threshold runs once approved."""


async def register_card(command: RegisterCard, uow: PaymentsUnitOfWork) -> Card:
    """Register and store a card."""
    card = Card.register(command.owner_id, command.number)
    async with uow:
        await uow.cards.add(card)
        await uow.commit()
    return card


@requires_approval(MAKE_TRANSFER)
async def make_transfer(command: MakeTransfer, uow: PaymentsUnitOfWork) -> Transfer:
    """Send the amount to the maker's card, within the maker's limits.

    Over the approval threshold it runs only once approved (the guard in
    ``apps.py``); the limits count it in the same transaction, so a refused
    one moved nothing. Its evidence is recorded once it commits, and its
    event is booked in the books (``handlers.book_transfer``).
    """
    check_bookable(command.amount)
    async with uow:
        card = await uow.cards.get(CardId(command.card_id))
        if card.owner_id != command.maker_id:
            raise CardNotFound(f"Card {command.card_id} does not exist.")
        transfer = Transfer.make(TransferId(command.transfer_id), card, command.amount)
        await uow.count_movement(
            transfer.amount,
            holder=str(transfer.maker_id),
            key=f"payments.transfer:{transfer.id}",
        )
        await uow.transfers.add(transfer)
        defer_evidence(uow, transfer_evidence(transfer))
        await uow.commit()
    return transfer


def check_bookable(amount: Money) -> None:
    """Refuse an amount the books take only with their own approvals.

    Over ``APPROVALS.ENTRY_THRESHOLDS``, a posting needs ``ENTRY_APPROVALS``
    approvals of its own, which a transfer's policy does not ask: its entry
    would be refused once the money had left. Limits raised above the
    thresholds therefore move nothing more: raise the thresholds with them.

    Raises:
        TransferTooLarge: The amount is over its currency's threshold, or
            the thresholds name no amount for its currency.
    """
    thresholds = registry.settings(ApprovalsSettings).ENTRY_THRESHOLDS
    if thresholds and Threshold(thresholds).exceeded_by([amount]):
        raise TransferTooLarge(
            "The books take a transfer of this amount, in this currency, "
            "only with their own approvals."
        )


def transfer_evidence(transfer: Transfer) -> Evidence:
    """What proves the transfer later, on the evidence ledger: ids and the amount."""
    return Evidence(
        kind="payments.transfer_made",
        subject=f"transfer:{transfer.id}",
        facts={
            "maker": str(transfer.maker_id),
            "card": str(transfer.card_id),
            "amount": transfer.amount.amount,
            "currency": transfer.amount.currency.code,
        },
    )
