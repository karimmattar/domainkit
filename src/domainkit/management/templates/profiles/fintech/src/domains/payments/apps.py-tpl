"""Installation hooks for the payments domain (Django's ``AppConfig``)."""

from typing import Final

from domainkit.apps import DomainConfig
from domainkit.contrib.approvals import Policy, Threshold, guard
from domainkit.ddd import event_bus

from domains.payments.application.commands import MakeTransfer
from domains.payments.application.handlers import book_transfer
from domains.payments.application.services import MAKE_TRANSFER, make_transfer
from domains.payments.domain.model import CURRENCIES, TransferMade
from domains.payments.infrastructure.orm import start_mappers
from domains.payments.infrastructure.unit_of_work import SqlAlchemyPaymentsUnitOfWork

APPROVAL_THRESHOLD: Final = Threshold({code: "1000.00" for code in CURRENCIES})
"""A transfer over this amount waits for another person's approval; one in a
currency it does not name always does (a threshold fails closed)."""


def large(command: MakeTransfer) -> bool:
    """Whether the transfer is over the approval threshold of its currency."""
    return APPROVAL_THRESHOLD.exceeded_by([command.amount])


class PaymentsConfig(DomainConfig):
    """Map the tables; book transfers; guard them with maker-checker."""

    requires = (
        "domainkit.contrib.accounting",
        "domainkit.contrib.approvals",
        "domainkit.contrib.evidence",
        "domainkit.contrib.limits",
    )

    def ready(self) -> None:
        """Connect the layers, book transfers, and guard large ones.

        Each transfer made is posted to the books by the worker, once.
        Large ones are approved by people who hold
        ``payments.approve_transfer`` and pass ``APPROVALS.APPROVE_RULE``, a
        step-up; the maker never approves. A direct call submits the
        transfer for approval (``ApprovalPending``, answered 202).
        """
        start_mappers()
        event_bus.subscribe(
            TransferMade, book_transfer, durable=True, name="payments.book_transfer"
        )
        guard(
            MAKE_TRANSFER,
            make_transfer,
            unit_of_work=SqlAlchemyPaymentsUnitOfWork,
            policies=[
                Policy(
                    "payments.large_transfer",
                    approvals=1,
                    permission="payments.approve_transfer",
                    when=large,
                ),
            ],
            permission="payments.add_transfer",
            submit=True,
        )
