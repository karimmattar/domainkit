"""Settings for production: addresses and secrets come from the environment.

Set {{ prefix }}SETTINGS_MODULE=config.settings.production,
{{ prefix }}ALLOWED_HOSTS (comma-separated), and {{ prefix }}DATABASE_URL.
Startup fails when one is missing, and the deployment checks refuse DEBUG,
wildcard hosts, and network databases without verified TLS.
"""

from config.settings.base import *
from config.settings.base import env

ENVIRONMENT = "production"
ALLOWED_HOSTS = env.list("ALLOWED_HOSTS")
DATABASES = {
    "default": {"URL": env.str("DATABASE_URL"), "SSLMODE": "verify-full"},
}
