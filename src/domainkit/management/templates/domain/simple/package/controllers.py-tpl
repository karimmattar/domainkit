"""What the {{ domain }} domain does: commands, and the use cases that run them.

A command is what a client asks for (data only). A use case opens the unit
of work, loads, calls the aggregate's methods, and commits. No HTTP and no
SQL here, so the API, a script, and a test all run the same code.
"""

from uuid import UUID

from domainkit.ddd import Command

from {{ package }}.domain import {{ Aggregate }}, {{ Aggregate }}Id, {{ Domain }}UnitOfWork


class Create{{ Aggregate }}(Command):
    """Create a {{ aggregate }} called ``name``."""

    name: str


class Rename{{ Aggregate }}(Command):
    """Give a {{ aggregate }} another name."""

    {{ aggregate }}_id: UUID
    name: str


async def create_{{ aggregate }}(command: Create{{ Aggregate }}, uow: {{ Domain }}UnitOfWork) -> {{ Aggregate }}:
    """Create and store a {{ aggregate }}."""
    {{ aggregate }} = {{ Aggregate }}.create(command.name)
    async with uow:
        await uow.{{ aggregates }}.add({{ aggregate }})
        await uow.commit()
    return {{ aggregate }}


async def rename_{{ aggregate }}(command: Rename{{ Aggregate }}, uow: {{ Domain }}UnitOfWork) -> {{ Aggregate }}:
    """Rename a {{ aggregate }}."""
    async with uow:
        {{ aggregate }} = await uow.{{ aggregates }}.get({{ Aggregate }}Id(command.{{ aggregate }}_id))
        {{ aggregate }}.rename(command.name)
        await uow.commit()
    return {{ aggregate }}
