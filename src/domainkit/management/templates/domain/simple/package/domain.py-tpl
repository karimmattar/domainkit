"""The business of the {{ domain }} domain: the ``{{ Aggregate }}`` aggregate and its rules.

Plain Python: only ``domainkit.ddd``, ``domainkit.money``, ``domainkit.clock``,
and the standard library. Change a {{ aggregate }} only through its methods, so
every way in (the API, a script, a test) meets the same rules.
"""

from abc import ABC
from typing import Annotated, Final, NewType, Self
from uuid import UUID, uuid4

from domainkit.ddd import (
    AggregateRoot,
    BusinessRuleViolation,
    DomainEvent,
    MaxLength,
    NotFound,
    Repository,
    UnitOfWork,
)

{{ Aggregate }}Id = NewType("{{ Aggregate }}Id", UUID)
NAME_LENGTH: Final = 200
# A field type, written once: the aggregate, the use cases, and the request
# schemas made from them all check it.
{{ Aggregate }}Name = Annotated[str, MaxLength(NAME_LENGTH)]


# Errors. Each becomes an HTTP answer by itself: NotFound is 404, and a
# BusinessRuleViolation is 422 with a code from its name (invalid_{{ aggregate }}_name).


class {{ Aggregate }}NotFound(NotFound):
    """No {{ aggregate }} has the requested id."""


class Invalid{{ Aggregate }}Name(BusinessRuleViolation):
    """The name is blank."""


# Events: facts that happened, stored with the change that made them.


class {{ Aggregate }}Renamed(DomainEvent):
    """A {{ aggregate }} got a new name."""

    {{ aggregate }}_id: {{ Aggregate }}Id
    name: str


# The aggregate.


class {{ Aggregate }}(AggregateRoot[{{ Aggregate }}Id]):
    """One {{ aggregate }}; change it only through its methods."""

    name: {{ Aggregate }}Name

    @classmethod
    def create(cls, name: str) -> Self:
        """Start a new {{ aggregate }}."""
        return cls(id={{ Aggregate }}Id(uuid4()), name=_checked(name))

    def rename(self, name: str) -> None:
        """Change the name, and record that it changed."""
        self.name = _checked(name)
        self.record({{ Aggregate }}Renamed({{ aggregate }}_id=self.id, name=self.name))


# Ports: what the business needs from storage. models.py implements them.


class {{ Aggregate }}Repository(Repository[{{ Aggregate }}, {{ Aggregate }}Id]):
    """Every {{ aggregate }}: ``get``, ``add``, ``filter``, ``paginate``, ..."""

    def not_found(self, id_: {{ Aggregate }}Id) -> {{ Aggregate }}NotFound:
        """Report a missing {{ aggregate }}."""
        return {{ Aggregate }}NotFound(f"{{ Aggregate }} {id_} does not exist.")


class {{ Domain }}UnitOfWork(UnitOfWork, ABC):
    """One transaction over the {{ domain }} domain's repositories."""

    {{ aggregates }}: {{ Aggregate }}Repository


def _checked(name: str) -> str:
    """The name, trimmed; a blank one breaks the rule."""
    if not name.strip():
        raise Invalid{{ Aggregate }}Name("The name must not be blank.")
    return name.strip()
