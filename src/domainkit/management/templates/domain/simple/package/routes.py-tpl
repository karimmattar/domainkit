"""The HTTP API of the {{ domain }} domain (docs/resources.md).

Reads are generic; each change is a command. Every route needs its model
permission: ``{{ domain }}.view_{{ model }}`` to read, ``add_`` to create,
``change_`` for other commands; superusers have them all.
"""

from domainkit.resources import ModelActions, ResourceRouter
from fastapi import APIRouter

from {{ package }} import controllers
from {{ package }}.domain import {{ Aggregate }}
from {{ package }}.models import SqlAlchemy{{ Domain }}UnitOfWork

router = APIRouter(tags=["{{ domain }}"])


async def get_unit_of_work() -> SqlAlchemy{{ Domain }}UnitOfWork:
    """A unit of work on the database; tests may override this dependency."""
    return SqlAlchemy{{ Domain }}UnitOfWork()


{{ aggregates }} = ResourceRouter(
    "/{{ aggregates }}",  # GET /{{ aggregates }}, GET /{{ aggregates }}/{{{ aggregate }}_id}
    model={{ Aggregate }},
    unit_of_work=get_unit_of_work,
    repository=lambda uow: uow.{{ aggregates }},
    rule=ModelActions({{ Aggregate }}),
)
# Each use case is a route; its body is made from its parameters, with their
# limits, and the {{ aggregate }}'s id comes from the path.
{{ aggregates }}.use_case(controllers.create_{{ aggregate }})  # POST /{{ aggregates }}
{{ aggregates }}.use_case(controllers.rename_{{ aggregate }}, path="/rename")  # POST /{{ aggregates }}/{id}/rename
router.include_router({{ aggregates }})
