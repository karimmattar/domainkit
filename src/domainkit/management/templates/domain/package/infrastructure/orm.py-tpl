"""Tables of the {{ domain }} domain, derived from the model and mapped onto it.

``table_for`` reads each class's fields, so a field is declared once and the
model stays free of SQLAlchemy. Notes are child entities: their table holds
the foreign key, and they load, save, and go with the {{ aggregate }}.
"""

from domainkit.db import children, map_imperatively, table_for
from sqlalchemy import Column, ForeignKey, Index

from {{ package }}.domain.model import {{ Aggregate }}, {{ Aggregate }}Note

{{ aggregates }} = table_for(
    {{ Aggregate }},
    "{{ table }}",
    Index("ix_{{ table }}_name_id", "name", "id"),  # Listings by name.
    domain="{{ domain }}",
)
{{ aggregate }}_notes = table_for(
    {{ Aggregate }}Note,
    "{{ table }}_notes",
    Column(
        "{{ aggregate }}_id",
        ForeignKey("{{ table }}.id", ondelete="CASCADE"),
        nullable=False,
        index=True,
    ),
    domain="{{ domain }}",
)


def start_mappers() -> None:
    """Map the aggregates and their children onto their tables (idempotent)."""
    map_imperatively({{ Aggregate }}Note, {{ aggregate }}_notes)
    map_imperatively(
        {{ Aggregate }},
        {{ aggregates }},
        properties={
            "notes": children(
                {{ Aggregate }}Note,
                order_by=[{{ aggregate }}_notes.c.added_at, {{ aggregate }}_notes.c.id],
            )
        },
    )
