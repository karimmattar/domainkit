"""HTTP resources of the {{ domain }} domain (docs/resources.md).

Reads are generic; each change is a command, one use case. Every route
needs its model permission: ``{{ domain }}.view_{{ model }}`` to read, and
``add_``, ``change_``, or ``delete_`` to change; superusers have them all.
"""

from uuid import UUID

from fastapi import APIRouter
from pydantic import BaseModel, Field

from domainkit.contrib.auth import AuthenticatedUser
from domainkit.http import Filter, FilterSet, Pagination
from domainkit.resources import ModelActions, PatchModel, ResourceRouter, schema_for
from {{ package }}.application import services
from {{ package }}.application.commands import (
    Add{{ Aggregate }}Note,
    Archive{{ Aggregate }},
    Create{{ Aggregate }},
    Delete{{ Aggregate }},
    Update{{ Aggregate }},
)
from {{ package }}.application.unit_of_work import {{ Domain }}UnitOfWork
from {{ package }}.domain.model import NAME_LENGTH, NOTE_LENGTH, {{ Aggregate }}
from {{ package }}.infrastructure.unit_of_work import SqlAlchemy{{ Domain }}UnitOfWork

router = APIRouter(tags=["{{ domain }}"])


def get_unit_of_work() -> {{ Domain }}UnitOfWork:
    """A unit of work on the database; tests may override this dependency."""
    return SqlAlchemy{{ Domain }}UnitOfWork()


def caller(user: AuthenticatedUser) -> UUID:
    """The caller's id: who creates a {{ aggregate }} owns it."""
    return user.id


class {{ Aggregate }}Filters(FilterSet):
    """``?archived=``, ``?owner_id=``, ``?search=``, and ``?ordering=-name``."""

    model = {{ Aggregate }}
    archived = Filter()
    owner_id = Filter()
    ordering_fields = ("name",)
    default_ordering = ("name",)
    search_fields = ("name",)


{{ Aggregate }}In = schema_for({{ Aggregate }}, write=True, include=["name"])


class {{ Aggregate }}Patch(PatchModel):
    """What a ``PATCH`` may change; what it leaves out stays."""

    name: str = Field(max_length=NAME_LENGTH)


class NoteIn(BaseModel):
    """A note's text."""

    text: str = Field(min_length=1, max_length=NOTE_LENGTH)


{{ aggregates }} = ResourceRouter(
    "/{{ aggregates }}",
    model={{ Aggregate }},
    unit_of_work=get_unit_of_work,
    repository=lambda uow: uow.{{ aggregates }},
    filters={{ Aggregate }}Filters,
    pagination=Pagination(max_limit=100),
    rule=ModelActions({{ Aggregate }}),
)
{{ aggregates }}.command_route(
    Create{{ Aggregate }},
    service=services.create_{{ aggregate }},
    body={{ Aggregate }}In,
    provide={"owner_id": caller},
)
{{ aggregates }}.command_route(
    Update{{ Aggregate }}, service=services.update_{{ aggregate }}, body={{ Aggregate }}Patch, method="PATCH"
)
{{ aggregates }}.command_route(Archive{{ Aggregate }}, service=services.archive_{{ aggregate }}, path="/archive")
{{ aggregates }}.command_route(
    Add{{ Aggregate }}Note, service=services.add_{{ aggregate }}_note, body=NoteIn, path="/notes"
)
{{ aggregates }}.command_route(Delete{{ Aggregate }}, service=services.delete_{{ aggregate }}, method="DELETE")
router.include_router({{ aggregates }})
