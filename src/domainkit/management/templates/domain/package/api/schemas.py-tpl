"""Request and response bodies; the domain model never leaves this layer as-is."""

from typing import Self
from uuid import UUID

from pydantic import BaseModel, ConfigDict, Field

from domainkit.ddd import Page
from domainkit.http import encode_cursor
from {{ package }}.domain.model import {{ Aggregate }}, {{ Aggregate }}Name


class {{ Aggregate }}In(BaseModel):
    """Body of a create request."""

    model_config = ConfigDict(extra="forbid")

    name: str = Field(max_length={{ Aggregate }}Name.MAX_LENGTH)


class Rename{{ Aggregate }}In(BaseModel):
    """Body of a rename request."""

    model_config = ConfigDict(extra="forbid")

    name: str = Field(max_length={{ Aggregate }}Name.MAX_LENGTH)


class {{ Aggregate }}Out(BaseModel):
    """A {{ aggregate }} as clients see it."""

    id: UUID
    name: str
    archived: bool
    version: int
    """Changes stored so far; increases with every successful update."""

    @classmethod
    def from_domain(cls, {{ aggregate }}: {{ Aggregate }}) -> Self:
        """Convert the aggregate."""
        return cls(
            id={{ aggregate }}.id,
            name={{ aggregate }}.name.value,
            archived={{ aggregate }}.archived,
            version={{ aggregate }}.version,
        )


class {{ Aggregate }}Page(BaseModel):
    """One page of {{ aggregates_title }}; send ``next_cursor`` back as ``cursor``."""

    items: list[{{ Aggregate }}Out]
    next_cursor: str | None = None

    @classmethod
    def from_domain(cls, page: Page[{{ Aggregate }}]) -> Self:
        """Convert the page; the cursor encodes the last item's position."""
        next_cursor = None
        if page.has_more:
            last = page.items[-1]
            next_cursor = encode_cursor([last.name.value, str(last.id)])
        return cls(
            items=[{{ Aggregate }}Out.from_domain(item) for item in page.items],
            next_cursor=next_cursor,
        )
