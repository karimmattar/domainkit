"""FastAPI dependencies; tests replace them with ``app.dependency_overrides``."""

from typing import Annotated
from uuid import UUID

from fastapi import Depends, Query

from domainkit.http import (
    CURSOR_PATTERN,
    MAX_CURSOR_LENGTH,
    InvalidCursor,
    decode_cursor,
)
from {{ package }}.application.unit_of_work import {{ Domain }}UnitOfWork
from {{ package }}.infrastructure.unit_of_work import SqlAlchemy{{ Domain }}UnitOfWork
from {{ package }}.settings import get_settings


def get_unit_of_work() -> {{ Domain }}UnitOfWork:
    """Return a new database-backed unit of work."""
    return SqlAlchemy{{ Domain }}UnitOfWork()


def get_page_size(limit: Annotated[int | None, Query(ge=1)] = None) -> int:
    """Return the requested page size, defaulted and capped by the settings."""
    settings = get_settings()
    return settings.PAGE_SIZE if limit is None else min(limit, settings.MAX_PAGE_SIZE)


def get_position(
    cursor: Annotated[
        str | None, Query(max_length=MAX_CURSOR_LENGTH, pattern=CURSOR_PATTERN)
    ] = None,
) -> tuple[str, UUID] | None:
    """Decode the previous page's ``next_cursor`` into a (name, id) position."""
    if cursor is None:
        return None
    name, raw_id = decode_cursor(cursor, 2)
    try:
        return name, UUID(raw_id)
    except ValueError:
        raise InvalidCursor from None


UnitOfWorkDep = Annotated[{{ Domain }}UnitOfWork, Depends(get_unit_of_work)]
PageSizeDep = Annotated[int, Depends(get_page_size)]
PositionDep = Annotated[tuple[str, UUID] | None, Depends(get_position)]
