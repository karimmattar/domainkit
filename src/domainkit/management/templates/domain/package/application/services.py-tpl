"""Use cases: open a unit of work, change one aggregate, commit.

Committing publishes the events the aggregate recorded. A request's
``If-Match`` is checked as ``get`` loads the aggregate (docs/resources.md).
"""

from domainkit.ddd import Unset
from {{ package }}.application.commands import (
    Add{{ Aggregate }}Note,
    Archive{{ Aggregate }},
    Create{{ Aggregate }},
    Delete{{ Aggregate }},
    Update{{ Aggregate }},
)
from {{ package }}.application.unit_of_work import {{ Domain }}UnitOfWork
from {{ package }}.domain.model import {{ Aggregate }}, {{ Aggregate }}Id, {{ Aggregate }}Name, OwnerId


async def create_{{ aggregate }}(command: Create{{ Aggregate }}, uow: {{ Domain }}UnitOfWork) -> {{ Aggregate }}:
    """Create and store a {{ aggregate }}."""
    {{ aggregate }} = {{ Aggregate }}.create({{ Aggregate }}Name(command.name), OwnerId(command.owner_id))
    async with uow:
        await uow.{{ aggregates }}.add({{ aggregate }})
        await uow.commit()
    return {{ aggregate }}


async def update_{{ aggregate }}(command: Update{{ Aggregate }}, uow: {{ Domain }}UnitOfWork) -> {{ Aggregate }}:
    """Change the fields the command sets."""
    async with uow:
        {{ aggregate }} = await uow.{{ aggregates }}.get({{ Aggregate }}Id(command.{{ aggregate }}_id))
        if not isinstance(command.name, Unset):
            {{ aggregate }}.rename({{ Aggregate }}Name(command.name))
        await uow.commit()
    return {{ aggregate }}


async def archive_{{ aggregate }}(command: Archive{{ Aggregate }}, uow: {{ Domain }}UnitOfWork) -> {{ Aggregate }}:
    """Archive a {{ aggregate }}."""
    async with uow:
        {{ aggregate }} = await uow.{{ aggregates }}.get({{ Aggregate }}Id(command.{{ aggregate }}_id))
        {{ aggregate }}.archive()
        await uow.commit()
    return {{ aggregate }}


async def add_{{ aggregate }}_note(command: Add{{ Aggregate }}Note, uow: {{ Domain }}UnitOfWork) -> {{ Aggregate }}:
    """Add a note to a {{ aggregate }}."""
    async with uow:
        {{ aggregate }} = await uow.{{ aggregates }}.get({{ Aggregate }}Id(command.{{ aggregate }}_id))
        {{ aggregate }}.add_note(command.text)
        await uow.commit()
    return {{ aggregate }}


async def delete_{{ aggregate }}(command: Delete{{ Aggregate }}, uow: {{ Domain }}UnitOfWork) -> None:
    """Delete a {{ aggregate }}; its notes go with it."""
    async with uow:
        {{ aggregate }} = await uow.{{ aggregates }}.get({{ Aggregate }}Id(command.{{ aggregate }}_id))
        {{ aggregate }}.delete()
        await uow.{{ aggregates }}.remove({{ aggregate }})
        await uow.commit()
