"""``{{ aggregates }}``: print {{ aggregates_title }} from the database."""

from argparse import ArgumentParser

from domainkit.management import BaseCommand
from {{ package }}.application import services
from {{ package }}.infrastructure.unit_of_work import SqlAlchemy{{ Domain }}UnitOfWork


class Command(BaseCommand):
    """List {{ aggregates_title }}; an example of an async domain command."""

    help = "Print {{ aggregates_title }} ordered by name."

    def add_arguments(self, parser: ArgumentParser) -> None:
        """Accept a page size."""
        parser.add_argument("--limit", type=int, default=20)

    async def handle(self, *, limit: int, **options: object) -> None:
        """Print one line per {{ aggregate }}."""
        uow = SqlAlchemy{{ Domain }}UnitOfWork()
        page = await services.list_{{ aggregates }}(uow, limit=limit)
        for {{ aggregate }} in page.items:
            state = " (archived)" if {{ aggregate }}.archived else ""
            self.write(f"{{{ aggregate }}.id}  {{{ aggregate }}.name.value}{state}")
