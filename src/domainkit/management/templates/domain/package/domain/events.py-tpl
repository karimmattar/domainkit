"""Facts the {{ domain }} model records; other domains may subscribe to them.

Events carry plain values, so they stay valid messages as the model evolves.
"""

from uuid import UUID

from domainkit.ddd import DomainEvent


class {{ Aggregate }}Created(DomainEvent):
    """{{ A_aggregate }} was created."""

    {{ aggregate }}_id: UUID
    name: str


class {{ Aggregate }}Renamed(DomainEvent):
    """{{ A_aggregate }} got a new name."""

    {{ aggregate }}_id: UUID
    name: str


class {{ Aggregate }}Archived(DomainEvent):
    """{{ A_aggregate }} was archived and became read-only."""

    {{ aggregate }}_id: UUID


class {{ Aggregate }}NoteAdded(DomainEvent):
    """A note was added to {{ a_aggregate }}."""

    {{ aggregate }}_id: UUID
    note_id: UUID


class {{ Aggregate }}Deleted(DomainEvent):
    """{{ A_aggregate }} was deleted, with its notes."""

    {{ aggregate }}_id: UUID
