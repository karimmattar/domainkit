"""HTTP resources of the {{ domain }} domain (docs/resources.md).

Reads are generic; each change is a command, one use case. Every route
needs its model permission: ``{{ domain }}.view_{{ model }}`` to read, and
``add_`` or ``change_`` to change; superusers have them all.
"""

from domainkit.resources import ModelActions, ResourceRouter, schema_for
from fastapi import APIRouter

from {{ package }}.application import services
from {{ package }}.application.commands import Create{{ Aggregate }}, Rename{{ Aggregate }}
from {{ package }}.domain.model import {{ Aggregate }}
from {{ package }}.infrastructure.unit_of_work import SqlAlchemy{{ Domain }}UnitOfWork

router = APIRouter(tags=["{{ domain }}"])


async def get_unit_of_work() -> SqlAlchemy{{ Domain }}UnitOfWork:
    """A unit of work on the database; tests may override this dependency."""
    return SqlAlchemy{{ Domain }}UnitOfWork()


{{ Aggregate }}In = schema_for({{ Aggregate }}, write=True, include=["name"])

{{ aggregates }} = ResourceRouter(
    "/{{ aggregates }}",
    model={{ Aggregate }},
    unit_of_work=get_unit_of_work,
    repository=lambda uow: uow.{{ aggregates }},
    rule=ModelActions({{ Aggregate }}),
)
{{ aggregates }}.command_route(Create{{ Aggregate }}, service=services.create_{{ aggregate }}, body={{ Aggregate }}In)
{{ aggregates }}.command_route(
    Rename{{ Aggregate }}, service=services.rename_{{ aggregate }}, body={{ Aggregate }}In, path="/rename"
)
router.include_router({{ aggregates }})
