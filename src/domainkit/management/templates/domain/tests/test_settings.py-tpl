"""The {{ domain }} domain's settings."""

import pytest

from domainkit import setup
from domainkit.conf import override_settings
from domainkit.exceptions import ImproperlyConfigured
from {{ package }}.settings import get_settings


def test_page_size_must_fit_the_maximum() -> None:
    """Inconsistent ``{{ DOMAIN }}`` values fail with the setting's name."""
    setup()
    assert get_settings().PAGE_SIZE <= get_settings().MAX_PAGE_SIZE

    with (
        override_settings({{ DOMAIN }}={"PAGE_SIZE": 5, "MAX_PAGE_SIZE": 1}),
        pytest.raises(ImproperlyConfigured, match="{{ DOMAIN }}"),
    ):
        get_settings()
