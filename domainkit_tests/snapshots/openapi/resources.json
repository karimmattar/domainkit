 "paths": {
  "/gadgets": {
   "get": {
    "description": "List gadgets",
    "operationId": "list_gadgets_gadgets_get",
    "parameters": [
     {
      "description": "Items per page.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 50,
       "description": "Items per page.",
       "maximum": 200,
       "minimum": 1,
       "title": "Limit",
       "type": "integer"
      }
     },
     {
      "description": "Items to skip.",
      "in": "query",
      "name": "offset",
      "required": false,
      "schema": {
       "default": 0,
       "description": "Items to skip.",
       "maximum": 10000,
       "minimum": 0,
       "title": "Offset",
       "type": "integer"
      }
     },
     {
      "description": "Only items whose color is this.",
      "in": "query",
      "name": "color",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "$ref": "#/components/schemas/Color"
        },
        {
         "type": "null"
        }
       ],
       "description": "Only items whose color is this.",
       "title": "Color"
      }
     },
     {
      "description": "Only items whose color is one of these.",
      "in": "query",
      "name": "color__in",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "items": {
          "$ref": "#/components/schemas/Color"
         },
         "maxItems": 50,
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "description": "Only items whose color is one of these.",
       "title": "Color  In"
      }
     },
     {
      "description": "Order by these fields; - for descending.",
      "in": "query",
      "name": "ordering",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "items": {
          "enum": [
           "name",
           "-name",
           "price",
           "-price"
          ],
          "type": "string"
         },
         "maxItems": 3,
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "description": "Order by these fields; - for descending.",
       "title": "Ordering"
      }
     },
     {
      "description": "Words to find in name, ignoring case.",
      "in": "query",
      "name": "search",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Words to find in name, ignoring case.",
       "title": "Search"
      }
     }
    ],
