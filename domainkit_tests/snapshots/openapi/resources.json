     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GadgetPage"
        }
       },
       "application/x-ndjson": {
        "schema": {
         "type": "string"
        }
       },
       "text/csv": {
        "schema": {
         "type": "string"
        }
       }
      },
      "description": "A page as JSON; every match as text/csv or application/x-ndjson, by Accept, up to 10000."
     },
     "401": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Unauthorized"
